#pragma once

// Copy this file to secrets.h and fill in real values. secrets.h is
// git-ignored so credentials never get committed.

// ---- Required ----

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Location for the weather pages. Two ways to set it -- use ONE:
//   A) Set ZIP_CODE (and ZIP_COUNTRY if you're not in the US) and leave
//      LATITUDE/LONGITUDE at 0 -- resolved once at boot via the free
//      api.zippopotam.us lookup (covers many countries' postal codes, see
//      https://zippopotam.us for supported countries and their codes).
//   B) Leave ZIP_CODE empty and set LATITUDE/LONGITUDE directly (geocode at
//      https://geocoding-api.open-meteo.com/v1/search?name=YOUR_CITY).
#define ZIP_CODE ""
#define ZIP_COUNTRY "us"
constexpr double LATITUDE = 0.0;
constexpr double LONGITUDE = 0.0;
#define LOCATION_NAME "Your City, ST"

// POSIX TZ string for your timezone, see https://en.wikipedia.org/wiki/Tz_database
#define TZ_POSIX "UTC0"

// IANA name, used only in the Open-Meteo API query (separate from TZ_POSIX,
// which configTzTime() needs instead).
#define TZ_IANA "UTC"

// ---- Optional: leave any of these blank ("") to disable that feature ----
// The dashboard adapts at boot -- pages for a blank integration below just
// won't be added to the swipe/tap navigation.

// Hubitat Maker API app -- create a "Maker API" app in Hubitat, select the
// devices to expose, and copy its base URL/app id/token from the app page.
// Powers the Tesla, HVAC, and window/door-sensor status. NOTE: which
// specific devices it reads (Tesla vehicle IDs, HVAC zone IDs, window
// sensor IDs) are hardcoded in src/tesla.cpp, src/hvac_zones.cpp, and
// src/windows_status.cpp respectively -- edit those device-ID lists
// directly for your own Hubitat devices; there's no generic way to expose
// "which devices" as a simple variable here since every Hubitat instance's
// device set is different.
#define HUBITAT_BASE_URL ""
#define HUBITAT_APP_ID ""
#define HUBITAT_TOKEN ""

// Home Assistant long-lived access token (Profile > Security > Long-Lived
// Access Tokens) and base URL, for reading power/battery sensor data.
// Powers the Solar page and the clock page's battery/load row. NOTE: like
// Hubitat above, the specific sensor entity IDs are hardcoded in
// src/home_power.cpp -- edit that file for your own HA entities.
#define HA_BASE_URL ""
#define HA_TOKEN ""

// Public Uptime Kuma status page (no auth needed -- it's the same URL
// you'd share with anyone to view your status page in a browser). Powers
// the System Status page and the status LED's red "something's down" state.
#define UPTIME_KUMA_BASE_URL ""
#define UPTIME_KUMA_SLUG ""
